#!/bin/sh /etc/rc.common
# openUF procd service
#
# Manages two background processes:
#   announce — sends L2 UDP discovery broadcasts (port 10001)
#   inform   — sends encrypted TNBU heartbeats to the controller

START=99
STOP=01
USE_PROCD=1

OPENUF_DIR=/opt/openuf

start_service() {
	# The Lua scripts (and conf.lua's modelmap dofile) load siblings with
	# cwd-relative paths, but procd starts services with cwd "/". Run each from
	# $OPENUF_DIR via `sh -c "cd ... && exec lua ..."` so those loads resolve.
	#
	# config.l2_announce = false (conf.lua) skips the broadcaster entirely,
	# for L3-only adoption. The instance is not started rather than started
	# and exited: procd would respawn a self-exiting process forever.
	#
	# conf.lua dofiles its modelmap by relative path, so the check has to run
	# from $OPENUF_DIR. Anything unexpected (missing lua, unreadable conf)
	# leaves the value empty and the broadcaster starts -- fail open, since
	# that is the documented default.
	l2=$(cd "$OPENUF_DIR" 2>/dev/null && lua -e 'dofile("conf.lua")
		print((config and config.l2_announce == false) and "off" or "on")' 2>/dev/null)
	if [ "$l2" != "off" ]; then
		procd_open_instance announce
		procd_set_param command /bin/sh -c "cd '$OPENUF_DIR' && exec lua announce.lua"
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	else
		echo "openuf: L2 announce disabled (config.l2_announce = false)"
	fi

	procd_open_instance inform
	procd_set_param command /bin/sh -c "cd '$OPENUF_DIR' && exec lua inform.lua"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd stops the two Lua instances itself. What it cannot see is the RRM
	# collector: rrmscan.collector_ensure() spawns `ubus subscribe hostapd.*`
	# with a trailing &, so it is reparented to init and outlives the daemon
	# that started it. Left behind it appends beacon-report notifications to
	# /tmp/openuf-rrm.jsonl forever, and harvest() -- the only thing that ever
	# truncates that file -- is gone with the inform loop. /tmp is a RAM disk
	# on these boards, so this is an unbounded leak, and `install.sh uninstall`
	# calls us on its way to removing $OPENUF_DIR.
	#
	# Driven through rrmscan.lua rather than a pkill here so the subscribe
	# pattern and the file path stay defined in exactly one place. Same
	# cd-then-lua shape as the l2_announce probe above, and best-effort for the
	# same reasons: this must not block a stop.
	(cd "$OPENUF_DIR" 2>/dev/null && lua -e 'dofile("rrmscan.lua").collector_stop()') \
		>/dev/null 2>&1
	return 0
}

# NO service_triggers(). A procd_add_reload_trigger on "network"/"wireless" was
# registered here and was unwired in both directions. It never fired for
# openUF's own writes -- those go through libuci-lua, which does not emit the
# ubus config.change event procd listens for -- and when something else fired
# it (a LuCI apply, /sbin/reload_config) it did not reload but RESTARTED, since
# /etc/rc.common degrades `reload` to `restart` when no reload_service() is
# defined. That cost an in-flight inform POST, reset the 10 s cadence and
# orphaned the RRM collector, on any unrelated wireless edit in LuCI. Nothing
# was gained either way: ucihelper.begin_pass() re-reads /etc/config/wireless
# on every heartbeat, so new config is picked up within 10 s regardless.
